Ejercicio 2
<?php
$mensaje_estado = "";
$nombre = "";
$email = "";
$consulta = "";

if ($_SERVER["REQUEST_METHOD"] == "POST") {
    $nombre   = trim($_POST["nombre"] ?? "");
    $email    = trim($_POST["email"] ?? "");
    $consulta = trim($_POST["consulta"] ?? "");

    if ($nombre === "" || $email === "" || $consulta === "") {
        $mensaje_estado = "Todos los campos son obligatorios.";
    } elseif (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
        $mensaje_estado = "El correo electrónico no es válido.";
    } else {
        $destinatario = "webmaster@xx.com";
        $asunto = "Nueva consulta desde el sitio";
        $cuerpo = "Nombre: $nombre\nEmail: $email\n\nConsulta:\n$consulta";

        $cabeceras  = "Content-type: text/plain; charset=UTF-8\r\n";
        $cabeceras .= "From: Sitio Web <webmaster@xx.com>\r\n";
        $cabeceras .= "Reply-To: $email\r\n";

        if (mail($destinatario, $asunto, $cuerpo, $cabeceras)) {
            $mensaje_estado = "Gracias, tu consulta fue enviada.";
            $nombre = "";
            $email = "";
            $consulta = "";
        } else {
            $mensaje_estado = "No se pudo enviar la consulta. Intenta más tarde.";
        }
    }
}
?>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Contacto</title>
</head>
<body>
<h1>Contacto</h1>

<?php if ($mensaje_estado !== "") { echo "<p>" . htmlspecialchars($mensaje_estado) . "</p>"; } ?>

<form action="<?php echo htmlspecialchars($_SERVER['PHP_SELF']); ?>" method="post">
    <p>Nombre:<br>
        <input type="text" name="nombre" value="<?php echo htmlspecialchars($nombre); ?>">
    </p>
    <p>Email:<br>
        <input type="text" name="email" value="<?php echo htmlspecialchars($email); ?>">
    </p>
    <p>Consulta:<br>
        <textarea name="consulta" rows="6" cols="50"><?php echo htmlspecialchars($consulta); ?></textarea>
    </p>
    <p><input type="submit" value="Enviar consulta"></p>
</form>
</body>
</html>

