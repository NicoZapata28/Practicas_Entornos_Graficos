        $url_sitio = "https://www.xx.com";
        $asunto = "$nombre_propio te recomienda este sitio";
        $cuerpo = "Hola $nombre_amigo,\n\n"
                . "$nombre_propio pensó que te podría interesar este sitio:\n"
                . "$url_sitio\n\n"
                . "¡Saludos!";

        $cabeceras  = "Content-type: text/plain; charset=UTF-8\r\n";
        $cabeceras .= "From: Sitio Web <webmaster@xx.com>\r\n";

        if (mail($email_amigo, $asunto, $cuerpo, $cabeceras)) {
            $mensaje_estado = "¡Recomendación enviada a " . htmlspecialchars($nombre_amigo) . "!";
            $nombre_amigo = "";
            $email_amigo = "";
