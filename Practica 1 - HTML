Ejercitación 5 - Documento con marcos
<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Frameset//EN" "http://www.w3.org/TR/html4/frameset.dtd">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<title>Documento con marcos</title>
</head>
<frameset rows="20%,60%,20%">
  <frameset cols="80%,20%">
    <frame src="encabezado.htm" name="encabezado" noresize="noresize">
    <frame src="logo.htm" name="logo" noresize="noresize">
  </frameset>
  <frameset cols="25%,75%">
    <frame src="menu.htm" name="menu">
    <frame src="Articulos.htm" name="principal">
  </frameset>
  <frame src="pie.htm" name="pie" noresize="noresize">
  <noframes>
    <body>
      <p>Este sitio requiere un navegador con soporte para marcos.</p>
    </body>
  </noframes>
</frameset>
</html>

