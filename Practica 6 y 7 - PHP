            echo "<td><a href='carrito.php?quitar=$id'>Quitar</a></td>";
            echo "</tr>";
        }
        mysqli_free_result($res);
    }

    echo "<tr><td colspan='3'><b>Total</b></td><td colspan='2'><b>$ " . number_format($total, 2, ',', '.') . "</b></td></tr>";
    echo "</table>";
